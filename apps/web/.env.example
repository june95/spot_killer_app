# Public configuration loaded by the Next.js web project in this directory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback during Supabase key transition:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_SPOT_PHOTOS=spot-photos

# Public ncpKeyId for NAVER Cloud Dynamic Map. Restrict allowed web service URLs in the console.
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=

# Supabase Auth provider dashboard callback URL for local web:
# http://localhost:3000/auth/callback
